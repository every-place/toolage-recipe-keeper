# Copy this file to .env for running on your computer. Never commit .env.
# Online, set the same names as environment variables on your host.

# Signs login cookies. Any long random string; keep it secret.
SECRET_KEY=paste-a-long-random-string

# Optional: Postgres (Neon). Leave unset to use data/recipes.db on this computer.
# DATABASE_URL=postgresql://...

# Set to 1 when the site is served over https (online), so login cookies are secure-only.
# COOKIE_SECURE=1

# FatSecret (used by the nutrition step, premium plan only)
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=
# FATSECRET_PROXY_URL=
